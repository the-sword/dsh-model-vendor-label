{
  "name": "dsh-model-vendor-label",
  "version": "0.4.0",
  "description": "模型选择器显示模型 id 而不是展示名；设置里可一键切回 DSH 默认显示。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "model-selector"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT"
}
